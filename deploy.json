{
  "schemaVersion": 1,
  "appId": "calendar",
  "imageRepository": "ghcr.io/hurdoo/calendar-share",
  "displayName": "캘공",
  "description": "Google Calendar 일정을 제한된 공유 링크로 공개하는 개인용 서비스",
  "containerPort": 8465,
  "healthPath": "/health/ready",
  "access": "public",
  "dataEnabled": true,
  "resources": {
    "memoryMiB": 512,
    "cpus": 1,
    "pids": 128
  },
  "ingressProfile": "standard",
  "environment": {
    "APP_TIME_ZONE": "Asia/Seoul",
    "LOG_LEVEL": "info",
    "TRUST_PROXY": "127.0.0.1,::1"
  },
  "requiredSecrets": [
    "ADMIN_PASSWORD_HASH",
    "SESSION_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GOOGLE_TOKEN_ENCRYPTION_KEY",
    "SHARE_LINK_SECRET"
  ],
  "optionalSecrets": [],
  "platform": "linux/arm64",
  "dockerfile": "Dockerfile",
  "context": ".",
  "checks": [
    ["pnpm", "db:check"],
    ["pnpm", "lint"],
    ["pnpm", "typecheck"],
    ["pnpm", "test"],
    ["pnpm", "build"],
    ["pnpm", "security:bundle-check"]
  ]
}
